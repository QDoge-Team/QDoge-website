# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Discord bot token, from https://discord.com/developers/applications -> your app -> Bot
DISCORD_BOT_TOKEN=

# Voice channel IDs (right-click a channel -> Copy Channel ID, with Developer Mode on).
# Leave any of these blank to skip that ticker.
DISCORD_CHANNEL_ID_QDOGE=
DISCORD_CHANNEL_ID_QTREAT=
DISCORD_CHANNEL_ID_QPAY=
DISCORD_CHANNEL_ID_QPAYHUB=

# Optional: milliseconds between updates (default 600000 = 10 minutes).
# UPDATE_INTERVAL_MS=600000
